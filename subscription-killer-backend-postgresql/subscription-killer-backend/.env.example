SECRET_KEY=replace-with-a-long-random-secret
APP_MODE=demo
FLASK_DEBUG=1
ENABLE_SCHEDULER=1
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/subscription_killer

# Optional BHASHINI integration credentials (implement selected pipeline request schema)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# Optional local Whisper model: tiny, base, small, medium, large
WHISPER_MODEL=base
